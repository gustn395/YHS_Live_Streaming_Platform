# MediaMTX WebRTC POC 전용 Caddyfile (결정 Q2=a: tls internal)
# - PC와 모바일 모두 https://<POC_LAN_IP>:8443 으로 접속한다.
# - HTTPS는 페이지 로딩과 WHIP/WHEP 시그널링에만 쓰인다.
#   실제 미디어(WebRTC)는 Caddy를 거치지 않고 <POC_LAN_IP>:8189/udp로 MediaMTX에 직접 간다.
{
	# 모든 인증서를 Caddy 내부 CA로 발급한다.
	local_certs
	# 컨테이너 안에서 OS 신뢰 저장소에 CA를 설치하려고 하지 않는다.
	skip_install_trust
	# HTTP(80) → HTTPS 리다이렉트를 쓰지 않는다. (8443만 사용)
	auto_https disable_redirects
	# IP로 접속하면 SNI가 비어 있으므로 LAN IP 인증서를 기본으로 쓴다.
	default_sni {$POC_LAN_IP}
	admin off
	# 8443/udp를 열지 않으므로 HTTP/3는 끈다. (브라우저에 쓸 수 없는 h3를 광고하지 않는다)
	servers {
		protocols h1 h2
	}
}

https://{$POC_LAN_IP}:8443, https://localhost:8443 {
	tls internal

	# WHIP/WHEP와 세션 PATCH/DELETE → MediaMTX
	# MediaMTX가 돌려주는 Location(/live/<name>/whip/<id>)이 그대로 맞도록 경로를 바꾸지 않는다.
	handle /live/* {
		reverse_proxy mediamtx:8889
	}

	# 테스트 기기에 설치할 내부 루트 CA 인증서 (공개 인증서만 제공한다. 개인 키는 제공하지 않는다)
	handle /ca/root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=yhs-poc-caddy-root.crt"
		file_server
	}

	# POC 웹 페이지
	handle {
		root * /srv
		header Cache-Control no-store
		file_server
	}

	log {
		output stdout
		format console
	}
}
