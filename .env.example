# =============================================================
# 환경변수 예시 파일
# 이 파일을 .env로 복사한 뒤 값을 채워 사용한다. (cp .env.example .env)
# 아래 값은 모두 로컬 개발용 예시이며 확정된 정책 값이 아니다.
# 실제 비밀번호·키 등 비밀값은 이 파일에 적지 않는다.
# =============================================================

# ----- 공통 -----
APP_ENV=local

# ----- Backend -----
BACKEND_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=live_streaming
DB_USERNAME=change_me
DB_PASSWORD=change_me

# ----- MediaMTX -----
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997

# ----- Caddy -----
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com
