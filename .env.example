# =============================================================
# 환경변수 예시 파일
# 이 파일을 .env로 복사한 뒤 값을 채워 사용한다. (cp .env.example .env)
# 아래 값은 모두 로컬 개발용 예시이며 확정된 정책 값이 아니다.
# 실제 비밀번호·키 등 비밀값은 이 파일에 적지 않는다.
# =============================================================

# ----- 공통 -----
APP_ENV=local

# ----- Backend -----
BACKEND_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=live_streaming
DB_USERNAME=change_me
DB_PASSWORD=change_me
# Google OIDC 로그인(docs/member/decisions.md MB-D023·MB-D024). 비어 있으면 Backend가 기동하지 않는다.
# Google Cloud Console의 승인된 Redirect URI: {MEMBER_OAUTH_PUBLIC_BASE_URL}/api/v1/auth/oauth2/code/google
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
MEMBER_OAUTH_PUBLIC_BASE_URL=http://localhost:8080

# ----- Frontend -----
# Vite 개발 서버의 /api proxy 대상. VITE_ 접두어가 아니라 번들에 들어가지 않는다(docs/frontend/decisions.md FE-D002).
FRONTEND_API_PROXY_TARGET=http://localhost:8080

# ----- MediaMTX -----
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997

# ----- Caddy -----
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com
